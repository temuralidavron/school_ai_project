# =============================================================================
# .env shabloni — YANGI MAKTAB SERVERI uchun:
#   cp .env.example .env && chmod 600 .env
# <...> bilan belgilangan joylarni to'ldiring. To'liq tartib: deploy/YANGI_MAKTAB.md
# =============================================================================

# Django
SECRET_KEY=<yangi kalit: python3 -c "from django.core.management.utils import get_random_secret_key as g; print(g())">
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,school_ai_web,<server_ip>
CORS_ALLOWED_ORIGINS=http://<server_ip>

# PostgreSQL (docker ichida — host kerak emas)
DB_NAME=school_ai
DB_USER=postgres
DB_PASSWORD=<kuchli parol>
DB_HOST=db
DB_PORT=5432

# MinIO (rasmlar ombori)
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=<kuchli login>
MINIO_SECRET_KEY=<kuchli parol>
MINIO_BUCKET_NAME=student-photos
MINIO_RECOGNITION_BUCKET=recognition-events
MINIO_USE_SSL=False

# AI sozlamalari (225-maktabda sinalgan qiymatlar — boshlang'ich uchun tegmang)
AI_GPU_ID=0
AI_DET_SIZE=1280
AI_FRAME_MAX_DIM=1280
AI_FRAME_INTERVAL=2.0
AI_UPSCALE_SMALL_FACES=False
AI_ACCEPT_THRESHOLD=0.50
AI_REVIEW_THRESHOLD=0.45
AI_INFERENCE_CONCURRENCY=4
AI_SKUD_PUSH_WORKERS=4
AI_MIN_FRONTAL_FRAMES=1
AI_MAX_YAW_DEG=40.0
AI_MAX_PITCH_DEG=40.0
AI_REVIEW_RECORDS_ATTENDANCE=False
AI_SAVE_EVENT_BASE64=True
AI_SKIP_LOCKED_TRACK=True
AI_INFERENCE_WARN_MS=2000
MIN_FACE_SIZE=80

# SKUD (edu.devel.uz) — parollarni loyiha mas'ulidan oling
SKUD_API_BASE_URL=https://edu.devel.uz
SKUD_CLIENT_ID=faceid
SKUD_CLIENT_SECRET=<skud client secret>
SKUD_ACCESS_TOKEN=<skud access token>
# MAKTAB RAQAMI — SKUD org_id. Tekshirish (INN chiqishi SHART):
#   docker compose exec web python3.14 manage.py sync_organizations --check <ORG_ID>
BOT_ORG_ID=<org_id>

# Kameralar (rtsp_tayyorla.sh bazaga yozadi — bu faqat zaxira default)
CAMERA_STREAM_TEMPLATE=
CAMERA_USER=admin
CAMERA_PASSWORD=admin

# Kafka / DeepStream (docker ichida — o'zgartirish shart emas)
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=deepstream-faces
KAFKA_GROUP_ID=attendance-consumer
DEEPSTREAM_CAMERA_ID=1
DEEPSTREAM_FRAME_SKIP=8

# Telegram bot (ixtiyoriy — bo'sh qolsa bot ishlamaydi, davomatga ta'sir yo'q)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=

# PTZ patrul (default o'chiq)
PATROL_MODE=off
PATROL_ONLY_DURING_LESSON=True

# =============================================================================
# 14-maktab (Qibray tumani) SERVERI uchun .env shabloni
# =============================================================================
# Ishlatish:
#   cp deploy/env.14maktab.example .env
#   nano .env          # <TO'LDIRING> yozilgan joylarni to'ldiring
#   chmod 600 .env     # ichida SKUD siri va kamera paroli bor
#
# Bu server FAQAT 14-maktab uchun ishlaydi (SKUD org_id = 59).
# Kameralar bilan to'g'ridan RTSP orqali ishlanadi — edu-api HLS proxy YO'Q.
# =============================================================================

# ─── Django ──────────────────────────────────────────────────────────────────
# SECRET_KEY ni shu buyruq bilan yarating:
#   docker compose run --rm web python3.14 -c \
#     "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<TO'LDIRING_yangi_tasodifiy_kalit>
DEBUG=False
ALLOWED_HOSTS=<TO'LDIRING_server_ip>,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://<TO'LDIRING_server_ip>

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_NAME=school_ai
DB_USER=postgres
DB_PASSWORD=<TO'LDIRING_kuchli_parol>
DB_HOST=db
DB_PORT=5432

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=<TO'LDIRING_kuchli_kalit>
MINIO_SECRET_KEY=<TO'LDIRING_kuchli_sir_15+_belgi>
MINIO_BUCKET_NAME=student-photos
MINIO_RECOGNITION_BUCKET=recognition-events
MINIO_USE_SSL=False

# ─── AI / GPU ────────────────────────────────────────────────────────────────
AI_GPU_ID=0

# DIQQAT — bu qiymat JONLI DETECTION uchun (sinfdagi uzoq, kichik yuzlar).
# `evrika` tag'ida o'lchangan: 640 -> 1280 davomatni +53% oshirgan.
AI_DET_SIZE=1280
AI_FRAME_MAX_DIM=1280
AI_FRAME_INTERVAL=1.0
AI_UPSCALE_SMALL_FACES=False

# ENROLLMENT (SKUD rasmidan etalon) uchun esa 640 KERAK — 1280 da sifatsiz
# portretlarda yuz TOPILMAYDI. Buni .env ga yozmang, buyruqda bering:
#   docker compose exec -e AI_DET_SIZE=640 web python3.14 manage.py \
#       sync_all_organizations --org-id 59 --step embeddings
# Batafsil: deploy/DEPLOY_14_MAKTAB.md, 7a-bo'lim.

AI_ACCEPT_THRESHOLD=0.50
AI_REVIEW_THRESHOLD=0.45
AI_INFERENCE_CONCURRENCY=1
AI_SKUD_PUSH_WORKERS=4

# Qaror/sifat siyosati — hozirgi ishlaydigan tizimdagi qiymatlar bilan bir xil.
# (settings.py da default'lari ham shu, lekin aniq yozilgani ma'qul: default
#  kelajakda o'zgarsa xulq jimgina siljib ketmasin.)
AI_MIN_FRONTAL_FRAMES=1
AI_MAX_YAW_DEG=40.0
AI_MAX_PITCH_DEG=40.0
AI_REVIEW_RECORDS_ATTENDANCE=False
AI_SAVE_EVENT_BASE64=True
AI_SKIP_LOCKED_TRACK=True
MIN_FACE_SIZE=80
AI_INFERENCE_WARN_MS=2000

# CSRF_TRUSTED_ORIGINS — BO'SH QOLDIRING. settings.py:119 uni ALLOWED_HOSTS dan
# avtomatik hosil qiladi (http://<host>:8000 + https://<host>), admin login
# DEBUG=False da ham ishlaydi.

# ─── SKUD (edu.devel.uz) ─────────────────────────────────────────────────────
# SKUD tizimi 225-maktab bilan BIR XIL — faqat org_id boshqa.
SKUD_API_BASE_URL=https://edu.devel.uz
SKUD_CLIENT_ID=faceid
SKUD_CLIENT_SECRET=<TO'LDIRING_SKUD_dan_oling>
SKUD_ACCESS_TOKEN=

# ─── 14-MAKTAB (eng muhim qator) ─────────────────────────────────────────────
# SKUD org_id = 59, INN = 206920340, nomi "14-maktab".
# Barcha manage buyruqlarida ham --org-id 59 beriladi.
BOT_ORG_ID=59

# ─── Kameralar — RTSP (to'g'ridan, proxy YO'Q) ────────────────────────────────
# 7 kamera: 10.144.10.10 ... 10.144.10.16 (SKUD deviceId bilan bir xil).
# stream_url har kamera uchun DB da (Camera.stream_url) saqlanadi —
# uni deploy/probe_cameras.sh topib deploy/cameras_14.csv ga yozadi.
# Shuning uchun bu shablon BO'SH qoladi:
CAMERA_STREAM_TEMPLATE=
CAMERA_USER=admin
CAMERA_PASSWORD=<TO'LDIRING_kamera_paroli>

# ─── Kafka / DeepStream ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=deepstream-faces
KAFKA_GROUP_ID=attendance-consumer

# DeepStream v3 jonli rejimda kameralarni sources.json dan oladi (Camera.stream_url).
# Quyidagi ikkitasi faqat eski/bitta-kamera rejimi uchun qoldirilgan:
DEEPSTREAM_CAMERA_ID=1
DEEPSTREAM_FRAME_SKIP=8

# ─── Telegram bot (ixtiyoriy — kerak bo'lmasa bo'sh qoldiring) ────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=

# ─── PTZ patrul (ixtiyoriy) ──────────────────────────────────────────────────
# off | sweep | preset | hybrid
PATROL_MODE=off
PATROL_ONLY_DURING_LESSON=True

# =============================================================================
# YOQILMAGAN FLAGLAR — ataylab yo'q.
# B5_MARGIN, B5_ELIM, B5_STAGED, GALLERY_CANDIDATES yozilmagan, ya'ni O'CHIQ.
# Bu holatda xulq `evrika` tag'i bilan aynan bir xil (2026-08-17 da demo bilan
# tasdiqlangan). Yangi mantiqni faqat o'lchagandan keyin, bittalab yoqing.
# =============================================================================
